# Copy to .env and fill values
# Generate a bcrypt hash of your admin password, e.g. using node:
#   node -e "const bcrypt=require('bcrypt'); bcrypt.hashSync('your-password',10); console.log(...)"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-this-with-a-secret
ADMIN_ROUTE=super-secret-route-123
PORT=3000
